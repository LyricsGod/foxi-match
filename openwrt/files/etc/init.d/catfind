#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled port
	config_load catfind
	config_get_bool enabled main enabled 0
	config_get port main port 8088

	[ "$enabled" = "1" ] || return 0
	[ -d /www/catfind ] || return 0
	[ -x /usr/sbin/uhttpd ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -h /www/catfind -p 0.0.0.0:"$port" -x /cgi-bin
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	# uhttpd 对 SIGTERM 不敏感，直接 SIGKILL 立刻释放端口，
	# 否则紧接着的 start 会抢不到端口而进入崩溃重试
	for pid in $(pgrep -f "uhttpd .* -h /www/catfind" 2>/dev/null); do
		kill -9 "$pid" 2>/dev/null
	done
	sleep 1
}
