#!/bin/sh
# 进度读写接口：GET 读取，POST 覆盖（限制 4KB 且必须是 JSON 对象）
F=/etc/catfind-progress.json

echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store, max-age=0"
echo ""

case "$REQUEST_METHOD" in
	POST|PUT)
		TMP="/tmp/catfind-progress.$$"
		head -c 4096 > "$TMP" 2>/dev/null
		if [ "$(head -c 1 "$TMP" 2>/dev/null)" = "{" ]; then
			mv "$TMP" "$F"
			chmod 644 "$F" 2>/dev/null
			echo '{"ok":true}'
		else
			rm -f "$TMP"
			echo '{"ok":false}'
		fi
		;;
	*)
		if [ -f "$F" ]; then
			cat "$F"
		else
			echo '{"level":1,"current":1,"stamp":0}'
		fi
		;;
esac
